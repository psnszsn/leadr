using Gtk 4.0;

template $LeadrEmojiPicker: Window {
  decorated: false;
  default-width: 500;
  default-height: 400;

  styles ["emoji-picker"]

  Box {
    orientation: vertical;
    spacing: 8;
    margin-start: 16;
    margin-end: 16;
    margin-top: 16;
    margin-bottom: 16;

    SearchEntry search_entry {
      placeholder-text: "Search emoji…";
    }

    ScrolledWindow {
      vexpand: true;

      FlowBox emoji_flow {
        homogeneous: true;
        max-children-per-line: 10;
        min-children-per-line: 5;
        selection-mode: single;
      }
    }

    Box preview_bar {
      orientation: horizontal;
      spacing: 12;

      styles ["emoji-preview"]

      Label preview_glyph {
        label: "";
      }

      Label preview_name {
        label: "";
        halign: start;
        hexpand: true;
      }
    }
  }
}
