using Gtk 4.0;

template $LeadrDictation: Window {
  decorated: false;
  default-width: 500;
  default-height: 300;

  styles ["dictation"]

  Box {
    orientation: vertical;
    spacing: 12;
    margin-start: 16;
    margin-end: 16;
    margin-top: 16;
    margin-bottom: 16;

    Label status_label {
      label: "Hold Space to record…";

      styles ["dictation-status"]
    }

    ScrolledWindow {
      vexpand: true;

      TextView text_view {
        editable: false;
        wrap-mode: word_char;
      }
    }
  }
}
