using Gtk 4.0;

template $LeadrOverlayWindow: Window {
  decorated: false;
  default-width: 600;
  default-height: 200;

  styles ["leadr-overlay"]

  Box {
    orientation: horizontal;
    halign: center;
    valign: center;
    hexpand: true;
    vexpand: true;
    spacing: 24;

    $LeadrKeyIndicator key_indicator {}
    $LeadrCheatsheet cheatsheet {}
  }
}
